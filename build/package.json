{
  "name": "noname-mac",
  "version": "1.11.6",
  "description": "无名杀 v1.11.6 — local macOS Apple Silicon build",
  "main": "app/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "module",
  "productName": "无名杀",
  "build": {
    "appId": "com.libnoname.noname",
    "productName": "无名杀",
    "asar": true,
    "files": [
      "app/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../game",
        "to": "game"
      }
    ],
    "directories": {
      "output": "../output"
    },
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "src/noname.icns"
    },
    "npmRebuild": false,
    "electronDist": "../electron-runtime",
    "afterPack": "./after-pack.cjs"
  },
  "devDependencies": {
    "electron": "^39.5.2",
    "electron-builder": "^26.7.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.7.4",
    "ws": "^8.22.0"
  }
}
